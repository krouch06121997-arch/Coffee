<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>កុម្ម៉ង់កាហ្វេ - តុ <span id="displayTableNum"><%= tableNum %></span></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        :root {
            --ios-bg: #140C07;
            --card-bg: rgba(255, 255, 255, 0.95);
            --coffee-primary: #3D2314;
            --coffee-accent: #D4A373;
            --ios-green: #34C759;
            --ios-green-grad: linear-gradient(135deg, #34C759 0%, #24A148 100%);
            --ios-gray: #F2F2F7;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Plus Jakarta Sans', sans-serif;
            background: var(--ios-bg);
            background-image: 
                radial-gradient(at 0% 0%, rgba(212, 163, 115, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(61, 35, 20, 0.5) 0px, transparent 50%);
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
            color: #1c1c1e;
            padding-bottom: 24px;
        }

        .mobile-container {
            max-width: 440px;
            margin: 0 auto;
            padding: 14px;
        }

        .ios-header {
            background: rgba(20, 12, 7, 0.85);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-radius: 18px;
            padding: 14px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
        }

        .table-pill {
            background: rgba(212, 163, 115, 0.15);
            color: #FFE8D6;
            border: 1px solid rgba(212, 163, 115, 0.3);
            border-radius: 99px;
            padding: 4px 12px;
            font-weight: 600;
            font-size: 0.8rem;
            display: inline-block;
            cursor: pointer;
        }

        .menu-card {
            background: var(--card-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 18px;
            border: 1px solid rgba(255, 255, 255, 0.7);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            overflow: hidden;
            transition: all 0.2s ease;
        }

        .product-img {
            width: 85px;
            height: 85px;
            object-fit: cover;
            border-radius: 14px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        }

        .sugar-segmented {
            background: var(--ios-gray);
            border-radius: 10px;
            padding: 2px;
            display: flex;
            gap: 2px;
        }

        .sugar-segmented input[type="radio"] {
            display: none;
        }

        .sugar-segmented label {
            flex: 1;
            text-align: center;
            padding: 5px 0;
            font-size: 0.7rem;
            font-weight: 600;
            color: #6c757d;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .sugar-segmented input[type="radio"]:checked + label {
            background: #FFFFFF;
            color: var(--coffee-primary);
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .qty-btn {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            border: none;
            background: var(--ios-gray);
            font-weight: 700;
            font-size: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--coffee-primary);
        }

        .qty-input {
            width: 32px;
            border: none;
            background: transparent;
            text-align: center;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .ios-input-note {
            background: var(--ios-gray) !important;
            border: 1px solid transparent !important;
            border-radius: 10px !important;
            font-size: 0.8rem;
            padding: 7px 10px;
        }

        .btn-ios-submit {
            background: var(--ios-green-grad);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 10px;
            font-weight: 600;
            font-size: 0.85rem;
            box-shadow: 0 4px 12px rgba(52, 199, 89, 0.3);
        }
    </style>
</head>
<body>
    <div class="mobile-container">
        
        <!-- Header -->
        <div class="ios-header text-center text-white mb-3">
            <div class="d-flex justify-content-center align-items-center gap-1.5 mb-1">
                <span style="font-size: 1.2rem;">☕</span>
                <h6 class="m-0 fw-bold" style="font-size: 0.95rem;">ម៉ឺនុយហាងកាហ្វេ</h6>
            </div>
            <div>
                <span class="table-pill" onclick="changeTable()">📍 តុលេខ <span id="currentTableText"><%= tableNum %></span> (ប្តូរ)</span>
            </div>
        </div>

        <!-- Menu List -->
        <div class="d-flex flex-column gap-2.5">
            <% if (items.length === 0) { %>
                <div class="text-center py-5 text-white-50">
                    <div class="fs-2 mb-2">☕</div>
                    <span style="font-size: 0.85rem;">មិនទាន់មាន Menu នៅឡើយទេ</span>
                </div>
            <% } %>

            <% items.forEach((item, idx) => { 
                let imgUrl = item.image_url;
                if(!imgUrl) {
                    const nameLower = item.name.toLowerCase();
                    if(nameLower.includes('latte') || nameLower.includes('ឡាតេ')) {
                        imgUrl = "https://images.unsplash.com/photo-1534778101976-62847782c213?q=80&w=300&auto=format&fit=crop";
                    } else if(nameLower.includes('black') || nameLower.includes('ខ្មៅ') || nameLower.includes('americano')) {
                        imgUrl = "https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?q=80&w=300&auto=format&fit=crop";
                    } else if(nameLower.includes('green') || nameLower.includes('តែបៃតង') || nameLower.includes('matcha')) {
                        imgUrl = "https://images.unsplash.com/photo-1536256263959-770b48d82b0a?q=80&w=300&auto=format&fit=crop";
                    } else if(nameLower.includes('milk') || nameLower.includes('តែដោះគោ')) {
                        imgUrl = "https://images.unsplash.com/photo-1572442388796-11668a67e53d?q=80&w=300&auto=format&fit=crop";
                    } else {
                        imgUrl = "https://images.unsplash.com/photo-1541167760496-1628856ab772?q=80&w=300&auto=format&fit=crop";
                    }
                }
            %>
            <div class="menu-card p-2.5">
                <form action="/<%= shopId %>/order" method="POST" onsubmit="attachTableToForm(this)">
                    <input type="hidden" name="table" id="form_table_<%= idx %>" value="<%= tableNum %>">
                    <input type="hidden" name="item_name" value="<%= item.name %>">
                    <input type="hidden" name="price" value="<%= item.price %>">

                    <div class="d-flex gap-2.5 align-items-center mb-2.5">
                        <img src="<%= imgUrl %>" alt="<%= item.name %>" class="product-img">
                        <div class="flex-grow-1">
                            <h6 class="fw-semibold mb-1 text-dark" style="font-size: 0.95rem;"><%= item.name %></h6>
                            <span class="text-success fw-bold" style="font-size: 0.85rem;">$<%= item.price.toFixed(2) %></span>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label mb-1 text-secondary" style="font-size: 0.7rem;"><span class="fw-semibold">កម្រិតស្ករ</span></label>
                        <div class="sugar-segmented">
                            <input type="radio" name="sugar" id="s100_<%= idx %>" value="100%" checked>
                            <label for="s100_<%= idx %>">100%</label>
                            <input type="radio" name="sugar" id="s75_<%= idx %>" value="75%">
                            <label for="s75_<%= idx %>">75%</label>
                            <input type="radio" name="sugar" id="s50_<%= idx %>" value="50%">
                            <label for="s50_<%= idx %>">50%</label>
                            <input type="radio" name="sugar" id="s25_<%= idx %>" value="25%">
                            <label for="s25_<%= idx %>">25%</label>
                            <input type="radio" name="sugar" id="s0_<%= idx %>" value="0%">
                            <label for="s0_<%= idx %>">0%</label>
                        </div>
                    </div>

                    <div class="row g-2 align-items-center mb-2.5">
                        <div class="col-5">
                            <div class="d-flex align-items-center bg-light rounded-2 p-0.5">
                                <button type="button" class="qty-btn" onclick="decrementQty('<%= idx %>')">−</button>
                                <input type="number" id="qty_<%= idx %>" name="qty" value="1" min="1" class="qty-input" readonly>
                                <button type="button" class="qty-btn" onclick="incrementQty('<%= idx %>')">+</button>
                            </div>
                        </div>
                        <div class="col-7">
                            <input type="text" name="note" class="form-control ios-input-note" placeholder="ចំណាំ (ឧ. ទឹកកកតិច)">
                        </div>
                    </div>

                    <div>
                        <button type="submit" class="btn btn-ios-submit w-100">
                            បញ្ជាទិញ
                        </button>
                    </div>
                </form>
            </div>
            <% }); %>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const shopId = "<%= shopId %>";
            const storageKey = `coffee_table_${shopId}`;
            const urlParams = new URLSearchParams(window.location.search);
            let table = urlParams.get('table');

            if (table) {
                localStorage.setItem(storageKey, table);
            } else {
                table = localStorage.getItem(storageKey);
                if (!table) {
                    table = prompt("សូមបញ្ចូលលេខតុរបស់អ្នក:", "1");
                    if (!table) table = "1";
                    localStorage.setItem(storageKey, table);
                }
            }

            document.getElementById('currentTableText').innerText = table;
            document.querySelectorAll('input[name="table"]').forEach(input => {
                input.value = table;
            });
        });

        function changeTable() {
            const shopId = "<%= shopId %>";
            const storageKey = `coffee_table_${shopId}`;
            let newTable = prompt("ប្តូរលេខតុថ្មី:", localStorage.getItem(storageKey) || "1");
            if (newTable) {
                localStorage.setItem(storageKey, newTable);
                document.getElementById('currentTableText').innerText = newTable;
                document.querySelectorAll('input[name="table"]').forEach(input => {
                    input.value = newTable;
                });
            }
        }

        function attachTableToForm(form) {
            const shopId = "<%= shopId %>";
            const storageKey = `coffee_table_${shopId}`;
            const currentTable = localStorage.getItem(storageKey) || "1";
            const tableInput = form.querySelector('input[name="table"]');
            if (tableInput) tableInput.value = currentTable;
        }

        function incrementQty(idx) {
            const input = document.getElementById('qty_' + idx);
            input.value = parseInt(input.value) + 1;
        }

        function decrementQty(idx) {
            const input = document.getElementById('qty_' + idx);
            if (parseInt(input.value) > 1) {
                input.value = parseInt(input.value) - 1;
            }
        }

        const socket = io({
            reconnection: true,
            reconnectionAttempts: Infinity,
            reconnectionDelay: 1000,
            timeout: 20000
        });

        const shopId = "<%= shopId %>";
        socket.emit('join_shop', shopId);

        socket.on('menu_updated', () => { window.location.reload(); });
        socket.on('reconnect', () => { window.location.reload(); });
    </script>
</body>
</html>

