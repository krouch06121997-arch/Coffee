<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>កុម្ម៉ង់កាហ្វេ - តុ <%= tableNum %></title>
    <!-- SF Pro Display / Inter & Khmer Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanten:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        :root {
            --ios-bg: #1C120C;
            --ios-card-bg: rgba(255, 255, 255, 0.88);
            --coffee-primary: #3D2314;
            --coffee-accent: #D4A373;
            --coffee-gradient: linear-gradient(135deg, #4A2E1B 0%, #2A160A 100%);
            --ios-green: #34C759;
            --ios-green-gradient: linear-gradient(135deg, #34C759 0%, #28A745 100%);
            --ios-input-bg: #F2F2F7;
            --ios-radius: 20px;
        }

        body {
            font-family: 'Plus Jakarta Sans', 'Kanten', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--ios-bg);
            background-image: 
                radial-gradient(at 0% 0%, rgba(212, 163, 115, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(61, 35, 20, 0.4) 0px, transparent 50%),
                url("https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?q=80&w=1000&auto=format&fit=crop");
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
            color: #1c1c1e;
        }

        /* Ambient Glass Container */
        .glass-container {
            background: rgba(28, 18, 12, 0.45);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            min-height: 100vh;
        }

        /* iOS Top Banner Header */
        .header-card {
            background: var(--coffee-gradient);
            border-radius: 24px;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.1);
            animation: fadeInDown 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Pulse Badge Animation */
        .pulse-badge {
            background: rgba(212, 163, 115, 0.25);
            color: #FEEAFA;
            border: 1px solid rgba(212, 163, 115, 0.5);
            animation: pulseGlow 2s infinite;
        }

        @keyframes pulseGlow {
            0% { box-shadow: 0 0 0 0 rgba(212, 163, 115, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(212, 163, 115, 0); }
            100% { box-shadow: 0 0 0 0 rgba(212, 163, 115, 0); }
        }

        /* Glassmorphism Menu Cards */
        .menu-card {
            background: var(--ios-card-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: var(--ios-radius);
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            animation: fadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) ease-in-out;
        }

        .menu-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 32px rgba(0, 0, 0, 0.18);
        }

        /* iOS Inputs & Selects */
        .ios-input, .ios-select {
            background-color: var(--ios-input-bg) !important;
            border: 1px solid transparent !important;
            border-radius: 12px !important;
            font-size: 0.9rem;
            color: #1c1c1e !important;
            transition: all 0.2s ease;
        }

        .ios-input:focus, .ios-select:focus {
            background-color: #FFFFFF !important;
            border-color: var(--coffee-accent) !important;
            box-shadow: 0 0 0 3px rgba(212, 163, 115, 0.25) !important;
        }

        /* iOS Active Touch Button */
        .btn-ios-order {
            background: var(--ios-green-gradient);
            color: #FFFFFF;
            border: none;
            border-radius: 14px;
            padding: 10px 16px;
            font-size: 0.95rem;
            box-shadow: 0 4px 14px rgba(52, 199, 89, 0.35);
            transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .btn-ios-order:active {
            transform: scale(0.96);
            box-shadow: 0 2px 8px rgba(52, 199, 89, 0.2);
            opacity: 0.9;
        }

        /* Animations Keyframes */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>
    <div class="glass-container py-4">
        <div class="container" style="max-width: 520px;">
            
            <!-- Header បង្ហាញលេខតុ -->
            <div class="header-card text-white text-center p-4 mb-4">
                <div class="d-flex justify-content-center align-items-center gap-2 mb-1">
                    <span class="fs-2">☕</span>
                    <h3 class="m-0 fw-bold tracking-tight">កុម្ម៉ង់កាហ្វេ</h3>
                </div>
                <div>
                    <span class="badge pulse-badge rounded-pill px-3 py-2 fs-6 mt-2 fw-semibold">
                        📍 តុលេខ <%= tableNum %>
                    </span>
                </div>
            </div>

            <!-- បញ្ជី Menu ភេសជ្ជៈ -->
            <div class="row g-3">
                <% if (items.length === 0) { %>
                    <div class="text-center py-5 text-white-50">
                        <div class="fs-1 mb-2">☕</div>
                        <h5 class="fw-bold">មិនទាន់មាន Menu នៅឡើយទេ</h5>
                        <small>សូមទាក់ទងបុគ្គលិកដើម្បីបន្ថែម Menu</small>
                    </div>
                <% } %>

                <% items.forEach((item, index) => { %>
                <div class="col-12" style="animation-delay: <%= index * 0.08 %>s;">
                    <div class="menu-card p-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0 fw-bold text-dark"><%= item.name %></h5>
                            <span class="fw-extrabold fs-5 text-success">$<%= item.price.toFixed(2) %></span>
                        </div>
                        
                        <form action="/<%= shopId %>/order" method="POST">
                            <input type="hidden" name="table" value="<%= tableNum %>">
                            <input type="hidden" name="item_name" value="<%= item.name %>">
                            <input type="hidden" name="price" value="<%= item.price %>">
                            
                            <div class="row g-2 align-items-center">
                                <!-- ជ្រើសរើសស្ករ ៥ កម្រិត -->
                                <div class="col-6">
                                    <label class="form-label mb-1 text-secondary"><small class="fw-semibold">🍬 ស្ករ</small></label>
                                    <select name="sugar" class="form-select form-select-sm ios-select fw-medium">
                                        <option value="100%">100%</option>
                                        <option value="75%">75%</option>
                                        <option value="50%">50%</option>
                                        <option value="25%">25%</option>
                                        <option value="0%">0% (ឥតស្ករ)</option>
                                    </select>
                                </div>

                                <!-- ជ្រើសរើសចំនួន -->
                                <div class="col-6">
                                    <label class="form-label mb-1 text-secondary"><small class="fw-semibold">🔢 ចំនួន</small></label>
                                    <input type="number" name="qty" value="1" min="1" class="form-control form-control-sm text-center ios-input fw-bold">
                                </div>

                                <!-- ប្រអប់ចំណាំសំណូមពរពិសេស (Special Note) -->
                                <div class="col-12 mt-2">
                                    <input type="text" name="note" class="form-control form-control-sm ios-input" placeholder="✍️ ចំណាំ (ឧ. ទឹកកកតិច, ដាក់ថង់...)">
                                </div>

                                <!-- ប៊ូតុងកុម្ម៉ង់ -->
                                <div class="col-12 mt-3">
                                    <button type="submit" class="btn btn-ios-order w-100 fw-bold d-flex justify-content-center align-items-center gap-2">
                                        <span>🛒</span>
                                        <span>ចុចកុម្ម៉ង់</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </div>

    <!-- Socket.io សម្រាប់ Auto Refresh ពេល Admin អាប់ដេត Menu -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        const shopId = "<%= shopId %>";

        socket.emit('join_shop', shopId);

        // ពេល Admin បន្ថែម/លុប Menu អេក្រង់ភ្ញៀវនឹងអាប់ដេតភ្លាមៗ
        socket.on('menu_updated', () => {
            window.location.reload();
        });
    </script>
</body>
</html>
