<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ម៉ឺនុយហាងកាហ្វេ - តុ <span id="displayTableNum"><%= tableNum %></span></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        :root {
            --ios-bg: #191410;
            --card-bg: rgba(35, 27, 21, 0.7);
            --card-border: rgba(212, 163, 115, 0.15);
            --coffee-primary: #D4A373;
            --ios-green-grad: linear-gradient(135deg, #34C759 0%, #24A148 100%);
            --ios-gray: rgba(255, 255, 255, 0.07);
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Plus Jakarta Sans', sans-serif;
            background-color: var(--ios-bg);
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(212, 163, 115, 0.08) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(139, 94, 60, 0.08) 0%, transparent 40%);
            background-attachment: fixed;
            min-height: 100vh;
            color: #F3F4F6;
            padding-bottom: 40px;
        }

        .mobile-container {
            max-width: 480px;
            margin: 0 auto;
            padding: 16px;
        }

        .ios-header {
            background: rgba(25, 20, 16, 0.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 16px;
            padding: 14px 16px;
            border: 1px solid var(--card-border);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            margin-bottom: 16px;
        }

        .table-pill {
            background: rgba(212, 163, 115, 0.12);
            color: #FFE8D6;
            border: 1px solid rgba(212, 163, 115, 0.25);
            border-radius: 99px;
            padding: 5px 14px;
            font-weight: 600;
            font-size: 0.8rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .table-pill:active { transform: scale(0.95); }

        /* 2 Columns Grid Layout */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .menu-card {
            background: var(--card-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 16px;
            border: 1px solid var(--card-border);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            cursor: pointer;
            transition: transform 0.15s ease, border-color 0.15s ease;
            padding: 10px;
        }
        .menu-card:active {
            transform: scale(0.97);
            border-color: rgba(212, 163, 115, 0.4);
        }

        .product-img-wrapper {
            width: 100%;
            height: 120px;
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 10px;
            background: rgba(255, 255, 255, 0.05);
        }

        .product-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }
        .menu-card:hover .product-img {
            transform: scale(1.05);
        }

        /* Center Modal Styling (Dark Smooth) */
        .modal-backdrop-custom {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(6px);
            z-index: 1050;
            opacity: 0; visibility: hidden;
            transition: all 0.2s ease;
        }
        .modal-backdrop-custom.active { opacity: 1; visibility: visible; }

        .center-modal {
            position: fixed;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%) scale(0.9);
            width: 90%; max-width: 360px;
            background: #231B15;
            border: 1px solid rgba(212, 163, 115, 0.2);
            border-radius: 20px;
            z-index: 1060;
            padding: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            opacity: 0; visibility: hidden;
            transition: all 0.25s cubic-bezier(0.1, 0.9, 0.2, 1);
            max-height: 90vh;
            overflow-y: auto;
            color: #F3F4F6;
        }
        .center-modal.active {
            opacity: 1; visibility: visible;
            transform: translate(-50%, -50%) scale(1);
        }

        .sugar-segmented {
            background: rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            padding: 3px;
            display: flex;
            gap: 2px;
        }
        .sugar-segmented input[type="radio"] { display: none; }
        .sugar-segmented label {
            flex: 1; text-align: center; padding: 7px 0; font-size: 0.7rem; font-weight: 600; color: #A1A1AA; border-radius: 9px; cursor: pointer; transition: all 0.15s ease;
        }
        .sugar-segmented input[type="radio"]:checked + label {
            background: #D4A373; color: #191410; box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }

        .qty-btn {
            width: 36px; height: 36px; border-radius: 10px; border: none; background: rgba(255, 255, 255, 0.08); font-weight: 700; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; color: #FFE8D6;
        }
        .qty-input {
            width: 40px; border: none; background: transparent; text-align: center; font-weight: 700; font-size: 1rem; color: #F3F4F6;
        }

        .ios-input-note {
            background: rgba(255, 255, 255, 0.06) !important; 
            border: 1px solid rgba(255, 255, 255, 0.1) !important; 
            color: #F3F4F6 !important;
            border-radius: 12px !important; 
            font-size: 0.85rem; 
            padding: 10px 14px;
        }
        .ios-input-note:focus {
            border-color: #D4A373 !important;
            box-shadow: none !important;
        }

        .btn-ios-submit {
            background: var(--ios-green-grad); color: white; border: none; border-radius: 14px; padding: 12px; font-weight: 600; font-size: 0.95rem; box-shadow: 0 4px 15px rgba(52, 199, 89, 0.3); width: 100%;
        }

        .close-modal-x {
            position: absolute; top: 12px; right: 15px; background: none; border: none; font-size: 1.2rem; color: #A1A1AA; cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="mobile-container">
        
        <!-- Header -->
        <div class="ios-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <div style="width: 32px; height: 32px; background: rgba(212,163,115,0.2); border-radius: 10px; display: flex; align-items: center; justify-content: center;">☕</div>
                <h6 class="m-0 fw-bold text-white" style="font-size: 0.95rem;">ម៉ឺនុយហាង</h6>
            </div>
            <div>
                <span class="table-pill" onclick="openTableModal()">
                    <span>📍 តុទី <span id="currentTableText"><%= tableNum %></span></span>
                </span>
            </div>
        </div>

        <!-- Menu Grid 2 Columns -->
        <div class="menu-grid" id="menuListContainer">
            <% if (items.length === 0) { %>
                <div class="text-center py-5 text-white-50 col-12">
                    <span style="font-size: 0.85rem;">មិនទាន់មាន Menu នៅឡើយទេ</span>
                </div>
            <% } %>

            <% items.forEach((item, idx) => { 
                let imgUrl = item.image_url;
                if(!imgUrl) {
                    const nameLower = item.name.toLowerCase();
                    if(nameLower.includes('latte') || nameLower.includes('ឡាតេ')) {
                        imgUrl = "https://images.unsplash.com/photo-1534778101976-62847782c213?q=80&w=300&auto=format&fit=crop";
                    } else if(nameLower.includes('black') || nameLower.includes('ខ្មៅ')) {
                        imgUrl = "https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?q=80&w=300&auto=format&fit=crop";
                    } else {
                        imgUrl = "https://images.unsplash.com/photo-1541167760496-1628856ab772?q=80&w=300&auto=format&fit=crop";
                    }
                }
            %>
            <div class="menu-card" onclick="openOrderModal('<%= item.name %>', '<%= item.price %>', '<%= imgUrl %>')">
                <div class="product-img-wrapper">
                    <img src="<%= imgUrl %>" alt="<%= item.name %>" class="product-img">
                </div>
                <div class="d-flex flex-column justify-content-between flex-grow-1 px-1">
                    <h6 class="fw-semibold mb-1 text-white text-truncate" style="font-size: 0.9rem;"><%= item.name %></h6>
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <span class="text-warning fw-bold" style="font-size: 0.9rem; color: #D4A373 !important;">$<%= item.price.toFixed(2) %></span>
                        <div style="width: 24px; height: 24px; background: rgba(255,255,255,0.08); border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #FFE8D6;">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        </div>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>
    </div>

    <!-- Center Screen Order Modal -->
    <div class="modal-backdrop-custom" id="modalBackdrop" onclick="closeOrderModal()"></div>
    <div class="center-modal" id="orderCenterModal">
        <button type="button" class="close-modal-x" onclick="closeOrderModal()">&times;</button>
        <form action="/<%= shopId %>/order" method="POST" id="orderForm" onsubmit="attachTableToForm(this)">
            <input type="hidden" name="table" id="sheet_table_input" value="<%= tableNum %>">
            <input type="hidden" name="item_name" id="sheet_item_name">
            <input type="hidden" name="price" id="sheet_item_price">

            <div class="text-center mb-3">
                <img id="sheet_img" src="" alt="" style="width: 80px; height: 80px; object-fit: cover; border-radius: 14px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); margin-bottom: 10px;">
                <h6 class="fw-bold mb-1 text-white" id="sheet_title" style="font-size: 1rem;"></h6>
                <span class="fw-bold" id="sheet_price_text" style="font-size: 0.95rem; color: #D4A373;"></span>
            </div>

            <div class="mb-3">
                <label class="form-label mb-1 text-white-50" style="font-size: 0.75rem; font-weight: 600;">កម្រិតស្ករ</label>
                <div class="sugar-segmented">
                    <input type="radio" name="sugar" id="s100" value="100%" checked><label for="s100">100%</label>
                    <input type="radio" name="sugar" id="s75" value="75%"><label for="s75">75%</label>
                    <input type="radio" name="sugar" id="s50" value="50%"><label for="s50">50%</label>
                    <input type="radio" name="sugar" id="s25" value="25%"><label for="s25">25%</label>
                    <input type="radio" name="sugar" id="s0" value="0%"><label for="s0">0%</label>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label mb-1 text-white-50" style="font-size: 0.75rem; font-weight: 600;">ចំនួន</label>
                <div class="d-flex align-items-center justify-content-center bg-black bg-opacity-25 rounded-2 p-1">
                    <button type="button" class="qty-btn" onclick="decrementQty()">−</button>
                    <input type="number" id="qty_input" name="qty" value="1" min="1" class="qty-input" readonly>
                    <button type="button" class="qty-btn" onclick="incrementQty()">+</button>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label mb-1 text-white-50" style="font-size: 0.75rem; font-weight: 600;">ចំណាំ (ជាជម្រើស)</label>
                <input type="text" name="note" class="form-control ios-input-note" placeholder="ឧ. ទឹកកកតិច">
            </div>

            <button type="submit" class="btn-ios-submit">
                បញ្ជាក់ការកុម្ម៉ង់
            </button>
        </form>
    </div>

    <!-- Table Selection Modal -->
    <div class="modal-backdrop-custom" id="tableModalBackdrop" onclick="closeTableModal()"></div>
    <div class="center-modal" id="tableModal">
        <h6 class="fw-bold mb-2 text-white" style="font-size: 1rem;">ជ្រើសរើសលេខតុ</h6>
        <p class="text-white-50 mb-3" style="font-size: 0.8rem;">សូមបញ្ចូលលេខតុរបស់អ្នកថ្មី</p>
        <input type="number" id="newTableInput" class="form-control ios-input-note mb-3" placeholder="ឧ. 10">
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-light w-50 rounded-3 py-2 fw-semibold" style="font-size: 0.85rem; border-color: rgba(255,255,255,0.2);" onclick="closeTableModal()">បោះបង់</button>
            <button type="button" class="btn w-50 rounded-3 py-2 fw-semibold text-dark" style="font-size: 0.85rem; background: #D4A373;" onclick="saveNewTable()">យល់ព្រម</button>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const shopId = "<%= shopId %>";
        const storageKey = `coffee_table_${shopId}`;

        document.addEventListener("DOMContentLoaded", () => {
            const urlParams = new URLSearchParams(window.location.search);
            let table = urlParams.get('table');

            if (table) {
                localStorage.setItem(storageKey, table);
            } else {
                table = localStorage.getItem(storageKey);
                if (!table) {
                    table = "1";
                    localStorage.setItem(storageKey, table);
                }
            }

            document.getElementById('currentTableText').innerText = table;
            document.getElementById('sheet_table_input').value = table;
        });

        function openTableModal() {
            document.getElementById('tableModalBackdrop').classList.add('active');
            document.getElementById('tableModal').classList.add('active');
            document.getElementById('newTableInput').value = localStorage.getItem(storageKey) || "1";
        }

        function closeTableModal() {
            document.getElementById('tableModalBackdrop').classList.remove('active');
            document.getElementById('tableModal').classList.remove('active');
        }

        function saveNewTable() {
            const val = document.getElementById('newTableInput').value;
            if (val) {
                localStorage.setItem(storageKey, val);
                document.getElementById('currentTableText').innerText = val;
                document.getElementById('sheet_table_input').value = val;
                closeTableModal();
            }
        }

        function openOrderModal(name, price, imgUrl) {
            document.getElementById('sheet_item_name').value = name;
            document.getElementById('sheet_item_price').value = price;
            document.getElementById('sheet_title').innerText = name;
            document.getElementById('sheet_price_text').innerText = "$" + parseFloat(price).toFixed(2);
            document.getElementById('sheet_img').src = imgUrl;
            document.getElementById('qty_input').value = 1;

            document.getElementById('modalBackdrop').classList.add('active');
            document.getElementById('orderCenterModal').classList.add('active');
        }

        function closeOrderModal() {
            document.getElementById('modalBackdrop').classList.remove('active');
            document.getElementById('orderCenterModal').classList.remove('active');
        }

        function attachTableToForm(form) {
            const currentTable = localStorage.getItem(storageKey) || "1";
            document.getElementById('sheet_table_input').value = currentTable;
        }

        function incrementQty() {
            const input = document.getElementById('qty_input');
            input.value = parseInt(input.value) + 1;
        }

        function decrementQty() {
            const input = document.getElementById('qty_input');
            if (parseInt(input.value) > 1) {
                input.value = parseInt(input.value) - 1;
            }
        }

        const socket = io({
            reconnection: true,
            reconnectionAttempts: Infinity,
            reconnectionDelay: 1000,
            timeout: 20000
        });

        socket.emit('join_shop', shopId);
        socket.on('menu_updated', () => { window.location.reload(); });
        socket.on('reconnect', () => { window.location.reload(); });
    </script>
</body>
</html>

