<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="/socket.io/socket.io.js"></script>
</head>
<body class="bg-light">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>👨‍💼 Admin Dashboard (<%= shopId %>)</h2>
            <span class="badge bg-warning text-dark fs-5">ចំណូលថ្ងៃនេះ៖ $<%= grandTotal.toFixed(2) %></span>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
            <h4 class="mb-3">📊 បញ្ជីកុម្ម៉ង់ Real-time</h4>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>តុ</th>
                            <th>ទំនិញ</th>
                            <th>ចំនួន</th>
                            <th>ចំណាំ</th>
                            <th>ស្ថានភាព</th>
                            <th>សកម្មភាព</th>
                        </tr>
                    </thead>
                    <tbody id="sales-list">
                        <% salesItems.forEach(s => { %>
                        <tr id="order-row-<%= s.id %>">
                            <td><span class="badge bg-secondary">តុ <%= s.table_num %></span></td>
                            <td class="fw-bold"><%= s.item_name %></td>
                            <td><%= s.quantity %> (ស្ករ <%= s.sugar %>)</td>
                            <td class="text-muted"><small><%= s.note %></small></td>
                            
                            <!-- បង្ហាញ Status -->
                            <td>
                                <% if(s.status === 'pending') { %>
                                    <span class="badge bg-warning text-dark" id="status-badge-<%= s.id %>">⏳ កំពុងឆុង</span>
                                <% } else if(s.status === 'ready') { %>
                                    <span class="badge bg-info text-dark" id="status-badge-<%= s.id %>">☕ ឆុងរួចរាល់</span>
                                <% } else { %>
                                    <span class="badge bg-success" id="status-badge-<%= s.id %>">✅ អតិថិជនបានទទួល</span>
                                <% } %>
                            </td>

                            <!-- ប៊ូតុងប្តូរ Status -->
                            <td>
                                <% if(s.status === 'pending') { %>
                                    <form action="/<%= shopId %>/admin/order-status" method="POST" class="d-inline">
                                        <input type="hidden" name="order_id" value="<%= s.id %>">
                                        <input type="hidden" name="status" value="ready">
                                        <button type="submit" class="btn btn-sm btn-primary rounded-3">ឆុងរួចរាល់</button>
                                    </form>
                                <% } else { %>
                                    <span class="text-muted small">-</span>
                                <% } %>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        const socket = io();
        const shopId = "<%= shopId %>";
        socket.emit('join_shop', shopId);

        // Order ថ្មីមកដល់
        socket.on('new_order', (order) => {
            const tbody = document.getElementById('sales-list');
            const newRow = `
                <tr id="order-row-${order.id}" class="table-warning">
                    <td><span class="badge bg-secondary">តុ ${order.table_num}</span></td>
                    <td class="fw-bold">${order.item_name}</td>
                    <td>${order.quantity} (ស្ករ ${order.sugar})</td>
                    <td class="text-muted"><small>${order.note}</small></td>
                    <td><span class="badge bg-warning text-dark" id="status-badge-${order.id}">⏳ កំពុងឆុង</span></td>
                    <td>
                        <form action="/${shopId}/admin/order-status" method="POST" class="d-inline">
                            <input type="hidden" name="order_id" value="${order.id}">
                            <input type="hidden" name="status" value="ready">
                            <button type="submit" class="btn btn-sm btn-primary rounded-3">ឆុងរួចរាល់</button>
                        </form>
                    </td>
                </tr>
            `;
            tbody.insertAdjacentHTML('afterbegin', newRow);
            new Audio('https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3').play();
        });

        // ទទួលបានសញ្ញាបញ្ជាក់ថា "អតិថិជនបានទទួលរួចរាល់" (Customer Confirmed)
        socket.on('customer_confirmed', (data) => {
            const badge = document.getElementById(`status-badge-${data.orderId}`);
            if(badge) {
                badge.className = "badge bg-success";
                badge.innerHTML = "✅ អតិថិជនបានទទួល";
            }
        });
    </script>
</body>
</html>
