<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>👨‍💼 Admin Dashboard</h2>
            <a href="/qrcodes" class="btn btn-outline-primary rounded-3">🖨️ មើល & Print QR Code ទាំង ១០ តុ</a>
        </div>
        
        <!-- កាតបង្ហាញចំណូលសរុប -->
        <div class="card bg-dark text-white p-4 rounded-4 shadow-sm mb-4">
            <small class="text-white-50">ចំណូលសរុប</small>
            <h1 class="display-5 fw-bold text-warning m-0">$<%= grandTotal.toFixed(2) %></h1>
        </div>

        <!-- ផ្នែកបន្ថែម Menu ថ្មី -->
        <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
            <h4 class="mb-3">🍱 បន្ថែម Menu ថ្មី</h4>
            <form action="/admin/menu/add" method="POST" class="row g-2">
                <div class="col-md-5">
                    <input type="text" name="name" class="form-control" placeholder="ឈ្មោះកាហ្វេ" required>
                </div>
                <div class="col-md-4">
                    <input type="number" step="0.01" name="price" class="form-control" placeholder="តម្លៃ ($)" required>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-success w-100">បន្ថែម Menu</button>
                </div>
            </form>
        </div>

        <div class="row">
            <!-- បញ្ជី Menu ដែលមាន -->
            <div class="col-md-5 mb-4">
                <div class="card border-0 shadow-sm rounded-4 p-3">
                    <h4 class="mb-3">📋 បញ្ជី Menu ទាំងអស់</h4>
                    <ul class="list-group list-group-flush">
                        <% menuItems.forEach(item => { %>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span><b><%= item.name %></b> - $<%= item.price.toFixed(2) %></span>
                            <a href="/admin/menu/delete/<%= item.id %>" class="btn btn-danger btn-sm rounded-3" onclick="return confirm('តើអ្នកពិតជាចង់លុបមែនទេ?')">លុប</a>
                        </li>
                        <% }); %>
                    </ul>
                </div>
            </div>

            <!-- តារាងប្រវត្តិលក់ -->
            <div class="col-md-7 mb-4">
                <div class="card border-0 shadow-sm rounded-4 p-3">
                    <h4 class="mb-3">📊 ប្រវត្តិលក់ចុងក្រោយ</h4>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>តុ</th>
                                    <th>ទំនិញ</th>
                                    <th>ចំនួន</th>
                                    <th>ស្ករ</th>
                                    <th>សរុប</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% salesItems.forEach(s => { %>
                                <tr>
                                    <td><span class="badge bg-secondary">តុ <%= s.table_num %></span></td>
                                    <td class="fw-bold"><%= s.item_name %></td>
                                    <td><%= s.quantity %></td>
                                    <td><span class="badge bg-info text-dark"><%= s.sugar %></span></td>
                                    <td class="text-success fw-bold">$<%= s.total.toFixed(2) %></td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
